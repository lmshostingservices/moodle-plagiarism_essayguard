{{!
    @template plagiarism_essayguard/student_question_card

    One per-question card on the student detail report: a header that expands/collapses
    the signal breakdown, the question text and student answer (always visible), and the
    hidden body with the score bar and signal table.

    Data attributes required for JS:
    * data-action="plagiarism_essayguard-student-togglecard" on the header (aria-controls = body id)

    Context variables required for this template:
    * slot - int question slot
    * cardid - string unique id of the card
    * bodyid - string unique id of the collapsible body
    * level - string low|medium|high|nodata
    * badgelabel - string upper-case risk label
    * title - string "Question N"
    * unmeasured - bool true when the slot was never assessed
    * score - int score 0-100
    * keystrokes, pastes, avgwpm, typing - string formatted header stats
    * hastexts - bool whether question text or answer text is present
    * questiontext - false or object, see plagiarism_essayguard/student_truncated_text
    * answertext - false or object, see plagiarism_essayguard/student_truncated_text
    * shownodatanotice - bool
    * barwidth - int 0-100
    * scoreline - string e.g. "42/100 — Medium Risk"
    * signaltable - object, see plagiarism_essayguard/student_signal_table

    Example context (json):
    {
        "slot": 2,
        "cardid": "essayguard-q-card-2",
        "bodyid": "essayguard-q-body-2",
        "level": "high",
        "badgelabel": "HIGH",
        "title": "Question 2",
        "unmeasured": false,
        "score": 71,
        "keystrokes": "Keystrokes: 140",
        "pastes": "Pastes: 3",
        "avgwpm": "Avg WPM: 96.4",
        "typing": "Typing: 12.5 s",
        "hastexts": true,
        "questiontext": {
            "id": "essayguard-qt-2",
            "islong": false,
            "short": "Describe the principles of assessment.",
            "full": "Describe the principles of assessment.",
            "morelabel": "more",
            "lesslabel": "less"
        },
        "answertext": false,
        "shownodatanotice": false,
        "barwidth": 71,
        "scoreline": "71/100 — High Risk",
        "signaltable": {
            "hasbreakdown": false
        }
    }
}}
<div id="{{cardid}}" class="essayguard-student-qcard essayguard-student-level-{{level}}">
    <div class="essayguard-student-qheader" role="button" tabindex="0"
         data-action="plagiarism_essayguard-student-togglecard"
         aria-expanded="false" aria-controls="{{bodyid}}">
        <span class="essayguard-student-qbadge"><span class="essayguard-student-qdot"></span>{{badgelabel}}</span>
        <strong class="essayguard-student-qtitle">{{title}}</strong>
        <span class="essayguard-student-qstats">
            {{#unmeasured}}
            <span class="essayguard-muted">{{#str}}student_scoreoutof, plagiarism_essayguard, —{{/str}}</span>
            {{/unmeasured}}
            {{^unmeasured}}
            <span><strong class="essayguard-student-qscore">{{score}}</strong>{{#str}}student_outof100compact, plagiarism_essayguard{{/str}}</span>
            {{/unmeasured}}
            <span>{{keystrokes}}</span>
            <span>{{pastes}}</span>
            <span>{{avgwpm}}</span>
            <span>{{typing}}</span>
            <span class="essayguard-muted"><span class="essayguard-student-qchevron" aria-hidden="true">&#9660;</span> {{#str}}signalsword, plagiarism_essayguard{{/str}}</span>
        </span>
    </div>

    {{#hastexts}}
    <div class="essayguard-student-qtexts">
        {{#questiontext}}
        <div>
            <div class="essayguard-student-qtextlabel">{{#str}}questionheading, plagiarism_essayguard{{/str}}</div>
            <div class="essayguard-student-qtextbox essayguard-student-qtextbox-question">
                {{> plagiarism_essayguard/student_truncated_text }}
            </div>
        </div>
        {{/questiontext}}
        {{#answertext}}
        <div>
            <div class="essayguard-student-qtextlabel">{{#str}}studentanswer, plagiarism_essayguard{{/str}}</div>
            <div class="essayguard-student-qtextbox essayguard-student-qtextbox-answer">
                {{> plagiarism_essayguard/student_truncated_text }}
            </div>
        </div>
        {{/answertext}}
    </div>
    {{/hastexts}}

    <div id="{{bodyid}}" class="essayguard-student-qbody" hidden>
        {{#shownodatanotice}}
        <div class="essayguard-student-nodatanotice">{{#str}}nodatanotice, plagiarism_essayguard{{/str}}</div>
        {{/shownodatanotice}}

        <div class="essayguard-student-qbarrow">
            <div class="essayguard-student-qbar">
                <div class="essayguard-student-barfill" style="width: {{barwidth}}%;"></div>
            </div>
            <span class="essayguard-student-qscoreline">{{scoreline}}</span>
        </div>

        {{#signaltable}}
            {{> plagiarism_essayguard/student_signal_table }}
        {{/signaltable}}
    </div>
</div>
