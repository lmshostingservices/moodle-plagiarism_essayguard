{{!
    @template plagiarism_essayguard/student_headline_metrics

    The handful of figures that explain a score, above the full behavioural table.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * headlinemetrics - Array of {label, value}.

    Example context (json):
    {
        "headlinemetrics": [
            {"label": "Paste events", "value": "1"},
            {"label": "Typing speed", "value": "96.0 words per minute"}
        ]
    }
}}
<h4 class="essayguard-headline-heading">{{#str}}headline_heading, plagiarism_essayguard{{/str}}</h4>
<dl class="essayguard-headline">
    {{#headlinemetrics}}
    <div class="essayguard-headline-item">
        <dt class="essayguard-headline-label">{{label}}</dt>
        <dd class="essayguard-headline-value">{{value}}</dd>
    </div>
    {{/headlinemetrics}}
</dl>
