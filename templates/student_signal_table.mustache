{{!
    @template plagiarism_essayguard/student_signal_table

    Per-signal breakdown table for one score record (attempt-level or per-question),
    with a collapsible status key, supplementary-factor rows and the capped total.

    Context variables required for this template:
    * hasbreakdown - bool false for records written before signal breakdowns were stored
    * rows - array of {num, name, max, points, fired, evidence (string[]), description}
    * baselinebonus - false or {points, deviation}
    * lingfallback - false or {points}
    * finalscore - string formatted final score, e.g. "42/100"
    * finallevel - string low|medium|high
    * precapnote - string pre-cap total note, empty when the cap did not apply

    Example context (json):
    {
        "hasbreakdown": true,
        "rows": [
            {
                "num": 1,
                "name": "Paste ratio",
                "max": 60,
                "points": 30,
                "fired": true,
                "evidence": ["Pasted fraction: 62%", "Paste events: 2"],
                "description": "Large fraction of the text arrived by paste."
            },
            {
                "num": 2,
                "name": "Keystroke count",
                "max": 10,
                "points": 0,
                "fired": false,
                "evidence": [],
                "description": "Too few keystrokes for the length of text."
            }
        ],
        "baselinebonus": {"points": 9, "deviation": "Deviation score: 0.612"},
        "lingfallback": {"points": 12},
        "finalscore": "45/100",
        "finallevel": "medium",
        "precapnote": "Pre-cap total: 51"
    }
}}
{{#hasbreakdown}}
<p class="essayguard-student-signalnote">{{#str}}signalbreakdownnote, plagiarism_essayguard{{/str}}</p>

<details class="essayguard-student-statuskey">
    <summary>&#9432;&nbsp;{{#str}}statuskey, plagiarism_essayguard{{/str}}</summary>
    <div class="essayguard-student-statuskey-body">
        <div class="essayguard-student-statuskey-item">
            <span class="essayguard-student-statuskey-term essayguard-student-statuskey-term-fired">&#9679;&nbsp;{{#str}}statusfired, plagiarism_essayguard{{/str}}</span>
            <span class="essayguard-student-statuskey-desc">{{#str}}statusfireddesc, plagiarism_essayguard{{/str}}</span>
        </div>
        <div class="essayguard-student-statuskey-item">
            <span class="essayguard-student-statuskey-term essayguard-student-statuskey-term-silent">&#9711;&nbsp;{{#str}}statussilent, plagiarism_essayguard{{/str}}</span>
            <span class="essayguard-student-statuskey-desc">{{#str}}statussilentdesc, plagiarism_essayguard{{/str}}</span>
        </div>
        <div class="essayguard-student-statuskey-item">
            <span class="essayguard-student-statuskey-term essayguard-student-statuskey-term-applied">{{#str}}statusapplied, plagiarism_essayguard{{/str}}</span>
            <span class="essayguard-student-statuskey-desc">{{#str}}statusapplieddesc, plagiarism_essayguard{{/str}}</span>
        </div>
    </div>
</details>

<table class="generaltable essayguard-student-signals">
    <thead>
        <tr>
            <th scope="col">{{#str}}colnum, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colsignal, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colmax, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colpts, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colstatus, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colevidence, plagiarism_essayguard{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr{{#fired}} class="essayguard-student-fired"{{/fired}}>
            <td class="essayguard-student-signum">{{num}}</td>
            <td{{#fired}} class="essayguard-student-signame-fired"{{/fired}}>{{name}}</td>
            <td class="essayguard-student-sigmax">{{max}}</td>
            <td>
                {{#fired}}<span class="essayguard-student-pts">+{{points}}</span>{{/fired}}
                {{^fired}}<span class="essayguard-student-pts-zero">0</span>{{/fired}}
            </td>
            <td>
                {{#fired}}
                <span class="essayguard-student-statuspill" title="{{#cleanstr}}statusfiredtitle, plagiarism_essayguard{{/cleanstr}}">&#9679; {{#str}}statusfired, plagiarism_essayguard{{/str}}</span>
                {{/fired}}
                {{^fired}}
                <span class="essayguard-student-status-silent" title="{{#cleanstr}}statussilenttitle, plagiarism_essayguard{{/cleanstr}}">&#9711; {{#str}}statussilent, plagiarism_essayguard{{/str}}</span>
                {{/fired}}
            </td>
            <td class="essayguard-student-evidence">
                {{#evidence}}
                <div>{{.}}</div>
                {{/evidence}}
                <div class="essayguard-student-sigdesc">{{description}}</div>
            </td>
        </tr>
        {{/rows}}

        {{#baselinebonus}}
        <tr class="essayguard-student-extra">
            <td class="essayguard-student-signum">&mdash;</td>
            <td class="essayguard-student-signame-fired"><em>{{#str}}baselinebonusname, plagiarism_essayguard{{/str}}</em></td>
            <td class="essayguard-student-sigmax">15</td>
            <td><span class="essayguard-student-pts">+{{points}}</span></td>
            <td><span class="essayguard-student-statuspill" title="{{#cleanstr}}appliedtitle, plagiarism_essayguard{{/cleanstr}}">{{#str}}statusapplied, plagiarism_essayguard{{/str}}</span></td>
            <td class="essayguard-student-evidence">
                <div class="essayguard-student-extradesc">{{#str}}baselinebonusdesc, plagiarism_essayguard{{/str}}</div>
                <div class="essayguard-student-sigdesc">{{deviation}}</div>
            </td>
        </tr>
        {{/baselinebonus}}

        {{#lingfallback}}
        <tr class="essayguard-student-extra">
            <td class="essayguard-student-signum">&mdash;</td>
            <td class="essayguard-student-signame-fired"><em>{{#str}}lingfallbackname, plagiarism_essayguard{{/str}}</em></td>
            <td class="essayguard-student-sigmax">35</td>
            <td><span class="essayguard-student-pts">+{{points}}</span></td>
            <td><span class="essayguard-student-statuspill" title="{{#cleanstr}}appliedtitle, plagiarism_essayguard{{/cleanstr}}">{{#str}}statusapplied, plagiarism_essayguard{{/str}}</span></td>
            <td class="essayguard-student-evidence essayguard-student-extradesc">{{#str}}lingfallbackdesc, plagiarism_essayguard{{/str}}</td>
        </tr>
        {{/lingfallback}}

        <tr class="essayguard-student-total">
            <td></td>
            <td>{{#str}}finalscore, plagiarism_essayguard{{/str}}</td>
            <td class="essayguard-student-sigmax">100</td>
            <td><span class="essayguard-student-finalscore essayguard-student-level-{{finallevel}}">{{finalscore}}</span></td>
            <td>{{#precapnote}}<span class="essayguard-student-precap">{{precapnote}}</span>{{/precapnote}}</td>
            <td></td>
        </tr>
    </tbody>
</table>
{{/hasbreakdown}}
{{^hasbreakdown}}
<p class="essayguard-student-nobreakdown">{{#str}}nobreakdown, plagiarism_essayguard{{/str}}</p>
{{/hasbreakdown}}
