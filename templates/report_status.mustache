{{!
    @template plagiarism_essayguard/report_status

    Warning banner listing the reasons Essay Guard is not scoring submissions for this activity.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * show - Whether any warning applies.
    * globaldisabled - The plugin is disabled site-wide.
    * cmdisabled - The plugin is disabled for this activity.
    * notunlocked - The site is not unlocked (Site ID / API key).
    * settingsurl - URL of the Essay Guard admin settings page.

    Example context (json):
    {
        "show": true,
        "globaldisabled": false,
        "cmdisabled": true,
        "notunlocked": true,
        "settingsurl": "https://example.com/admin/settings.php?section=plagiarismsettingessayguard"
    }
}}
{{#show}}
<div class="eg-status-banner" role="alert">
    <span aria-hidden="true">&#x26A0;</span> <strong>{{#str}}notscoring, plagiarism_essayguard{{/str}}</strong>
    <ul class="eg-status-banner-list">
        {{#globaldisabled}}
        <li>{{#str}}warnglobaldisabled, plagiarism_essayguard{{/str}}<a href="{{settingsurl}}">{{#str}}warnglobaldisabledlink, plagiarism_essayguard{{/str}}</a></li>
        {{/globaldisabled}}
        {{#cmdisabled}}
        <li>{{#str}}warncmdisabled, plagiarism_essayguard{{/str}}</li>
        {{/cmdisabled}}
        {{#notunlocked}}
        <li>{{#str}}warnnotunlocked, plagiarism_essayguard{{/str}}<a href="{{settingsurl}}">{{#str}}settingslink, plagiarism_essayguard{{/str}}</a>{{#str}}warnnotunlockedtail, plagiarism_essayguard{{/str}}</li>
        {{/notunlocked}}
    </ul>
</div>
{{/show}}
