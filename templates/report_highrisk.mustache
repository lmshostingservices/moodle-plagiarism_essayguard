{{!
    @template plagiarism_essayguard/report_highrisk

    Cross-student behaviour summary listing high-risk students and their primary signal.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hashighrisk - Whether any student is high risk.
    * highrisk - Array of high-risk students, each with:
        * fullname - Student display name.
        * score - Overall score 0-100.
        * risklabel - Upper-case high risk label.
        * signal - Label of the highest-scoring signal.
        * detailurl - URL of the student report.

    Example context (json):
    {
        "hashighrisk": true,
        "highrisk": [
            {
                "fullname": "Ann Smith",
                "score": 72,
                "risklabel": "HIGH",
                "signal": "Large paste",
                "detailurl": "https://example.com/plagiarism/essayguard/student.php?cmid=5&userid=3"
            }
        ]
    }
}}
<h4 class="eg-section-heading eg-section-heading-spaced">{{#str}}crossheading, plagiarism_essayguard{{/str}}</h4>
<p class="eg-similarity-note">{{#str}}crossnote, plagiarism_essayguard{{/str}}</p>
{{^hashighrisk}}
<p class="eg-no-similarity">{{#str}}nohighrisk, plagiarism_essayguard{{/str}}</p>
{{/hashighrisk}}
{{#hashighrisk}}
<table class="generaltable eg-similarity-table">
    <thead>
        <tr>
            <th scope="col">{{#str}}colstudent, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colscore, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colprimarysignal, plagiarism_essayguard{{/str}}</th>
            <th scope="col">{{#str}}colactions, plagiarism_essayguard{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#highrisk}}
        <tr>
            <td class="eg-student-name-plain">{{fullname}}</td>
            <td><span class="eg-score-badge eg-score-badge-high">{{score}}/100 &nbsp;&nbsp;{{risklabel}}</span></td>
            <td class="eg-signal-label">{{signal}}</td>
            <td><a href="{{detailurl}}" class="eg-action-btn">{{#str}}viewreport, plagiarism_essayguard{{/str}}</a></td>
        </tr>
        {{/highrisk}}
    </tbody>
</table>
{{/hashighrisk}}
