{{!
    @template plagiarism_essayguard/badge

    Risk badge shown beside a submission, with links for teachers.

    Context variables required for this template:
    * state - low, medium, high, unmeasured, pending or error.
    * label - Badge text.
    * tooltip - Explanation shown on hover.
    * isteacher - Whether to show the teacher links.
    * detailurl - Optional per-student detail page URL.
    * reporturl - Class report URL (teachers).
    * errmsg - Optional error detail (teachers).

    Example context (json):
    {
        "state": "medium",
        "label": "Essay Guard Medium · 42%",
        "tooltip": "Some signals triggered.",
        "isteacher": true,
        "detailurl": "https://example.com/plagiarism/essayguard/student.php?cmid=2&userid=3",
        "reporturl": "https://example.com/plagiarism/essayguard/report.php?cmid=2"
    }
}}
<div class="essayguard-wrap">
    <span class="essayguard-badge essayguard-badge-{{state}}" data-eg-tip="{{tooltip}}" title="{{tooltip}}">
        <span class="essayguard-badge-dot essayguard-badge-dot-{{state}}" aria-hidden="true"></span>{{label}}
    </span>
    {{#isteacher}}
        <span class="essayguard-links">
            {{#detailurl}}<a href="{{detailurl}}" class="essayguard-link">{{#str}}detaillink, plagiarism_essayguard{{/str}}</a>{{/detailurl}}
            <a href="{{reporturl}}" class="essayguard-link">{{#str}}classreportlink, plagiarism_essayguard{{/str}}</a>
        </span>
        {{#errmsg}}<small class="essayguard-errmsg">{{errmsg}}</small>{{/errmsg}}
    {{/isteacher}}
</div>
