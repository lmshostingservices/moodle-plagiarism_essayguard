{{!
    @template plagiarism_essayguard/disclosure

    Notice shown to students above a monitored submission form.

    Context variables required for this template:
    * paragraphs - List of notice paragraphs, each with a "text" property.

    Example context (json):
    {
        "paragraphs": [
            {"text": "This activity records how you type."},
            {"text": "Data is kept for 90 days."}
        ]
    }
}}
<div class="essayguard-disclosure" role="note">
    <h3 class="essayguard-disclosure-heading">{{#str}}disclosure_heading, plagiarism_essayguard{{/str}}</h3>
    {{#paragraphs}}
        <p>{{text}}</p>
    {{/paragraphs}}
</div>
