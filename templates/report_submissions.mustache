{{!
    @template plagiarism_essayguard/report_submissions

    Submissions matrix: one row per student, one column per question.

    Replaces the earlier layout, which put each question on its own indented row beneath
    the student. That made it impossible to read down a question and see which learners
    stand out on it, which is the comparison a marker actually wants.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * qcolumns - Array of question columns, each with:
        * label - Column heading, e.g. "Question 1".
    * hasqcolumns - Whether any question columns exist.
    * notassessed - Sentence naming how many learners have no data, or empty.
    * rows - Array of student rows, each with:
        * fullname - Student display name.
        * profileurl - URL of the student's course profile.
        * showemail - Whether the email identity field may be shown.
        * email - Student email address.
        * ishigh - Whether the row is high risk (row highlight).
        * detailurl - URL of the student report.
        * cells - Array of per-question cells in column order, each with:
            * level - Risk level key (low, medium, high, nodata).
            * hasdata - Whether the question was assessed.
            * badge - Badge text, e.g. "Essay Guard · High 78".

    Example context (json):
    {
        "hasqcolumns": true,
        "notassessed": "1 student not assessed",
        "qcolumns": [{"label": "Question 1"}, {"label": "Question 2"}],
        "rows": [
            {
                "fullname": "Tom Nguyen",
                "profileurl": "https://example.com/user/view.php?id=3&course=2",
                "showemail": false,
                "email": "",
                "ishigh": true,
                "detailurl": "https://example.com/plagiarism/essayguard/student.php?cmid=5&userid=3",
                "cells": [
                    {"level": "high", "hasdata": true, "badge": "Essay Guard · High 78"},
                    {"level": "nodata", "hasdata": false, "badge": "Essay Guard · Not assessed"}
                ]
            }
        ]
    }
}}
<div class="essayguard-report-head">
    <h4 class="essayguard-section-heading">
        <svg class="essayguard-shield-icon" width="17" height="17" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        {{#str}}essayguardreport, plagiarism_essayguard{{/str}}
    </h4>
    <p class="essayguard-report-standfirst">
        {{#str}}reportsortnote, plagiarism_essayguard{{/str}}
        {{#notassessed}} &middot; {{notassessed}}{{/notassessed}}
        &middot; {{#str}}reportmeasurenote, plagiarism_essayguard{{/str}}
    </p>
</div>
<div class="essayguard-table-scroll">
    <table class="generaltable essayguard-class-table essayguard-matrix-table">
        <thead>
            <tr>
                <th scope="col">{{#str}}colstudent, plagiarism_essayguard{{/str}}</th>
                {{#qcolumns}}
                <th scope="col">{{label}}</th>
                {{/qcolumns}}
                {{^hasqcolumns}}
                <th scope="col">{{#str}}colrisk, plagiarism_essayguard{{/str}}</th>
                {{/hasqcolumns}}
                <th scope="col"><span class="sr-only">{{#str}}colactions, plagiarism_essayguard{{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
            <tr{{#ishigh}} class="essayguard-row-high"{{/ishigh}}>
                <th scope="row" class="essayguard-matrix-student">
                    <a href="{{profileurl}}" class="essayguard-student-name">{{fullname}}</a>
                    {{#showemail}}<br><small class="essayguard-student-email">{{email}}</small>{{/showemail}}
                </th>
                {{#cells}}
                <td>
                    <span class="essayguard-pill essayguard-pill-{{level}}">
                        <svg class="essayguard-pill-icon" width="11" height="11" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                            stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        {{badge}}
                    </span>
                </td>
                {{/cells}}
                <td class="essayguard-matrix-action">
                    <a href="{{detailurl}}" class="essayguard-action-btn">{{#str}}viewdetail, plagiarism_essayguard{{/str}}</a>
                </td>
            </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
